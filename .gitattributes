# Zeilenenden normalisieren fuer Text
* text=auto

# Unity YAML als Text behandeln, damit Merges moeglich sind
*.cs      text diff=csharp
*.shader  text
*.cginc   text
*.hlsl    text
*.uxml    text
*.uss     text
*.asmdef  text
*.json    text
*.md      text
*.meta    text
*.unity   text
*.prefab  text
*.asset   text
*.mat     text
*.controller text
*.anim    text

# --- Git LFS: vorerst AUS ---
# Ursprünglich war Git LFS für alle großen Binärdateien geplant. Entscheidung
# vom 2026-09-01: LFS wird nicht benutzt. Gründe:
#   - GitHub blockt Dateien erst ab 100 MB; unsere größte hat 6 MB.
#   - Auf diesem Mac ist git-lfs nicht installiert (kein Homebrew).
#   - LFS bringt viel Zusatzärger für wenig Nutzen bei dieser Projektgröße.
# Die Regeln bleiben als Kommentar stehen, falls das Projekt mal so groß wird,
# dass LFS sich lohnt. Dann git-lfs installieren, "git lfs install" ausführen
# und das führende "# " vor den Zeilen entfernen.
#
# 3D-Modelle
# *.fbx   filter=lfs diff=lfs merge=lfs -text
# *.obj   filter=lfs diff=lfs merge=lfs -text
